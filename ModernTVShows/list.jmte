<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="robots" content="noindex, nofollow"/>
<title>Series</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%230b0b0e'/%3E%3Cpolygon points='9,6 19,12 9,18' fill='%23f5a623'/%3E%3C/svg%3E"/>
<link rel="stylesheet" href="style.css"/>
</head>
<body>
<header class="topbar">
	<div class="topbar-inner">
		<div class="brand">
			<h1 data-i18n="showsTitle">Series</h1>
			<span class="count"><span id="resultCount"></span> <span data-i18n="titlesSuffix">títulos</span></span>
		</div>
		<a class="crosslink" href="../movies/movielist.html" data-route="movies" data-root="../" data-rest="movielist.html" data-i18n="toMovies">← Películas</a>
		<a class="crosslink" href="../collections/moviesets.html" data-route="collections" data-root="../" data-rest="moviesets.html" data-i18n="toCollections">Colecciones →</a>
		<div class="search-wrap">
			<svg viewBox="0 0 512 512"><path d="M337.5 305.4h-17.5l-6.6-5.5c20.8-25.2 33.9-57 33.9-93.3C347.4 127.6 283.9 64 205.1 64 127.5 64 64 127.6 64 206.6s63.5 142.6 142.2 142.6c35 0 67.8-13.2 93-34l6.6 5.5v17.5L448 448l32-32-142.5-110.6zm-131.3 0c-54.7 0-98.5-43.9-98.5-98.7 0-54.9 43.8-98.7 98.5-98.7 54.7 0 98.5 43.9 98.5 98.7 0 54.9-43.8 98.7-98.5 98.7z"/></svg>
			<input type="search" id="search" placeholder="Buscar por título, año o género…" data-i18n-placeholder="searchPlaceholder" autocomplete="off"/>
		</div>
		<button type="button" class="filter-toggle" id="filterToggle" data-i18n="filterToggle">Filtros ▾</button>
		<div class="lang-switcher" id="langSwitcher">
			<button type="button" data-lang="ca">CA</button>
			<button type="button" data-lang="es">ES</button>
			<button type="button" data-lang="en">EN</button>
		</div>
	</div>
	<nav class="az-bar" id="azBar" aria-label="Filtre alfabètic"></nav>
	<div class="filters" id="filters">
		<div class="filter-group">
			<label data-i18n="genre">Género</label>
			<div class="genre-mode" id="genreMode">
				<button type="button" data-mode="and" class="active" data-i18n="genreModeAnd" data-i18n-title="genreModeAndTitle">Y</button>
				<button type="button" data-mode="or" data-i18n="genreModeOr" data-i18n-title="genreModeOrTitle">O</button>
			</div>
			<div class="chip-row" id="genreChips"></div>
			<small class="filter-hint" data-i18n="genreHint">Clic: incluir · segundo clic: excluir · tercero: quitar</small>
		</div>
		<div class="filter-group">
			<label data-i18n="decadeYear">Década / Año</label>
			<div class="select-pair">
				<select id="decadeSelect"><option value="" data-i18n="yearAll">Todos</option></select>
				<select id="yearSelect"><option value="" data-i18n="yearAll">Todos</option></select>
			</div>
		</div>
		<div class="filter-group">
			<label data-i18n="collection">Colección</label>
			<select id="collectionSelect"><option value="" data-i18n="collectionAll">Todas</option></select>
		</div>
		<div class="filter-group">
			<label data-i18n="durationEpisode">Duración de episodio</label>
			<select id="durationSelect" data-i18n-title="durationHint">
				<option value="" data-i18n="durationAll">Todas</option>
				<option value="40" data-i18n="dur40"></option>
				<option value="70" data-i18n="dur70"></option>
				<option value="90" data-i18n="dur90"></option>
				<option value="100" data-i18n="dur100"></option>
				<option value="110" data-i18n="dur110"></option>
				<option value="120" data-i18n="dur120"></option>
				<option value="130" data-i18n="dur130"></option>
				<option value="160" data-i18n="dur160"></option>
				<option value="160+" data-i18n="durMore"></option>
				<option value="unknown" data-i18n="durUnknown"></option>
			</select>
		</div>
		<div class="filter-group">
			<label data-i18n="versions">Versiones</label>
			<button type="button" class="chip" id="versionsToggle"><span data-i18n="versionsOnly">Solo con varias versiones</span> <span id="versionsCount"></span></button>
		</div>
		<div class="filter-group">
			<label data-i18n="sortBy">Ordenar por</label>
			<select id="sortSelect">
				<option value="title-asc" data-i18n="sortTitleAsc">Título (A-Z)</option>
				<option value="year-desc" data-i18n="sortYearDesc">Año (nuevo → viejo)</option>
				<option value="year-asc" data-i18n="sortYearAsc">Año (viejo → nuevo)</option>
			</select>
		</div>
		<button type="button" class="clear-filters" id="clearFilters" data-i18n="clearFilters">Borrar filtros</button>
	</div>
</header>

<main>
	<div class="active-filter-pill" id="activeFilterPill" hidden>
		<div class="active-filter-pill-inner">
			<span id="activeFilterText"></span>
			<button type="button" id="activeFilterClear" aria-label="×">×</button>
		</div>
	</div>
	<div class="grid" id="grid" data-kind="tvshows">
		${foreach tvShows show}
		<div class="card"
			data-title="${show.titleSortable}"
			data-name="${show.title}"
			data-edition=""
			data-seasons="${if show.seasonCount}${show.seasonCount}${end}"
			data-episodes="${if show.episodeCount}${show.episodeCount}${end}"
			data-runtime="${if show.runtime}${show.runtime}${end}"
			data-vid="${if show.ids.tmdb}tmdb:${show.ids.tmdb}${else}${if show.ids.tvdb}tvdb:${show.ids.tvdb}${else}${if show.ids.imdb}imdb:${show.ids.imdb}${end}${end}${end}"
			data-year="${show.year}"
			data-genres="${foreach show.genres genre |}${genre}${end}"
			data-rating="0"
			data-collection=""
			data-actors="${if show.actors}${foreach show.actors actor |}${actor.name}${end}${end}"
			data-directors="${if show.crew}${foreach show.crew person |}${if person.role="Director"}${person.name}${end}${end}${end}"
			data-studio="${if show.productionCompany}${show.productionCompany}${end}">
			<a class="poster-link" href="${show;filename(escape=false)}/tvshow.html">
				<img src="images/${show;copyArtwork(type=POSTER, thumb=true, width=350, escape=true, default=nopicture.png)}" alt="${show.title}" loading="lazy" onerror="this.onerror=null;this.src='nopicture.png';"/>
				${if show.seasonCount}<span class="badge quality">${show.seasonCount}<span class="seasons-abbrev" data-i18n="seasonsAbbrev">T</span></span>${end}
				<div class="overlay"><p>${foreach show.genres genre , }${genre}${end}</p></div>
			</a>
			<div class="meta">
				<a class="title" href="${show;filename(escape=false)}/tvshow.html">${show.title}</a>
				<div class="sub">${show.year}</div>
			</div>
		</div>
		${end}
	</div>
	<div class="empty-state" id="emptyState" data-i18n="emptyShows">Ninguna serie coincide con los filtros actuales.</div>
</main>

<footer class="site-footer" data-i18n="footer">Generado con tinyMediaManager · plantilla Modern Grid</footer>

<script src="../config.js"></script>
<script src="app.js"></script>
</body>
</html>
