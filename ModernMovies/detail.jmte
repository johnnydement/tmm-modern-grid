<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="robots" content="noindex, nofollow"/>
<title>${movie.title} (${movie.year})</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%230b0b0e'/%3E%3Cpolygon points='9,6 19,12 9,18' fill='%23f5a623'/%3E%3C/svg%3E"/>
<link rel="stylesheet" href="../style.css"/>
</head>
<body>

<div class="hero" style="background-image:url('../images/${movie;copyArtwork(type=FANART, thumb=false, width=1280, escape=true, default=../nofanart.png)}');">
	<a class="back-btn" href="../movielist.html" title="Volver al listado" data-i18n-title="backToList">
		<svg viewBox="0 0 512 512"><path d="M401.4 224h-214l83-79.4c11.9-12.5 11.9-32.7 0-45.2s-31.2-12.5-43.2 0L89 233.4c-6 5.8-9 13.7-9 22.4v.4c0 8.7 3 16.6 9 22.4l138.1 134c12 12.5 31.3 12.5 43.2 0 11.9-12.5 11.9-32.7 0-45.2l-83-79.4h214c16.9 0 30.6-14.3 30.6-32 .1-18-13.6-32-30.5-32z"/></svg>
	</a>
	<div class="hero-links">
		<a class="crosslink" href="../../index.html" data-route="home" data-root="../../" data-rest="" data-i18n="toHome">⌂ Inicio</a>
		<a class="crosslink stats" href="../../stats.html" data-route="stats" data-root="../../" data-rest="" data-i18n="toStats">Estadísticas</a>
	</div>
	<div class="lang-switcher" id="langSwitcher">
		<button type="button" data-lang="ca">CA</button>
		<button type="button" data-lang="es">ES</button>
		<button type="button" data-lang="en">EN</button>
	</div>
	<div class="hero-inner">
		<div class="hero-poster">
			<img src="../images/${movie;copyArtwork(type=POSTER, thumb=true, width=320, escape=true, default=../nopicture.png)}" alt="${movie.title}" onerror="this.onerror=null;this.src='../nopicture.png';"/>
		</div>
		<div class="hero-info">
			<h1>${movie.title}</h1>
			${if movie.tagline}<p class="tagline">${movie.tagline}</p>${end}
			<div class="badge-row">
				<span class="pill">${movie.year}</span>
				${if movie.runtime}<span class="pill">${movie.runtime} min</span>${end}
				${if movie.certification}<span class="pill">${movie.certification}</span>${end}
				${if movie.edition}<span class="pill">${movie.edition}</span>${end}
			</div>
			<div class="genre-row">
				${foreach movie.genres genre}<a class="chip" href="../movielist.html?genre=${genre}">${genre}</a>${end}
			</div>
			${if movie.movieSet}
			<p><a class="chip" href="../../collections/${movie.movieSet}/movieset.html" data-route="collections" data-root="../../" data-rest="${movie.movieSet}/movieset.html"><span data-i18n="collectionPrefix">📚 Colección: </span>${movie.movieSet}</a></p>
			${end}
		</div>
	</div>
</div>

<div class="detail-body">
	<div class="main">
		<div class="plot">
			<h2 class="section-title" data-i18n="synopsisTitle">Sinopsis</h2>
			<p>${movie.plot}</p>
		</div>
		<div class="versions-box" id="versionsBox" hidden data-kind="movies" data-list="../movielist.html" data-vid="${if movie.ids.tmdb}tmdb:${movie.ids.tmdb}${else}${if movie.ids.imdb}imdb:${movie.ids.imdb}${end}${end}"></div>
		${if movie.actors}
		<h2 class="section-title" data-i18n="castTitle">Reparto</h2>
		<div class="cast-row">
			${foreach movie.actors actor}<span class="actor"><a class="person-link" href="../movielist.html?actor=${actor.name}">${actor.name}</a>${if actor.role} <span class="role">— ${actor.role}</span>${end}</span>${end}
		</div>
		${end}
	</div>
	<aside class="side">
		<h2 class="section-title" data-i18n="techSheetTitle">Ficha técnica</h2>
		<table class="tech-table">
			${if movie.crew}<tr><td data-i18n="directorLabel">Director</td><td><span class="trim-trail">${foreach movie.crew person}${if person.role="Director"}<a class="person-link" href="../movielist.html?director=${person.name}">${person.name}</a>, ${end}${end}</span></td></tr>${end}
			${if movie.productionCompany}<tr><td data-i18n="studioLabel">Estudio</td><td><span class="studio-list" data-base="../movielist.html">${movie.productionCompany}</span></td></tr>${end}
			${if movie.certification}<tr><td data-i18n="certificationLabel">Certificación</td><td>${movie.certification}</td></tr>${end}
			${if movie.edition}<tr><td data-i18n="editionLabel">Edición</td><td>${movie.edition}</td></tr>${end}
			<tr><td data-i18n="videoLabel">Vídeo</td><td><span class="video-slot"></span></td></tr>
			<tr><td data-i18n="audioLabel">Audio</td><td><span class="audio-slot"></span></td></tr>
			<tr><td data-i18n="languagesLabel">Idiomas</td><td><span class="lang-slot"></span></td></tr>
			<tr><td data-i18n="sizeLabel">Tamaño</td><td><span class="size-slot"></span></td></tr>
		</table>
		<span class="media-data" hidden data-media="${foreach movie.mediaFiles mf}${mf.type}~${mf.videoWidth}x${mf.videoHeight}~${mf.videoCodec}~${mf.hdrFormat}~${mf.filesize}~${foreach mf.audioStreams a}${a.audioChannels}:${a.language},${end}§${end}"></span>
	
	</aside>
</div>

<footer class="site-footer" data-i18n="footer">Generado con tinyMediaManager · plantilla Modern Grid</footer>
<script src="../../config.js"></script>
<script src="../app.js"></script>
</body>
</html>
