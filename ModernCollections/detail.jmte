<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="robots" content="noindex, nofollow"/>
<title>${movieSet.title}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%230b0b0e'/%3E%3Cpolygon points='9,6 19,12 9,18' fill='%23f5a623'/%3E%3C/svg%3E"/>
<link rel="stylesheet" href="../style.css"/>
</head>
<body>

<div class="hero" style="background-image:${if movieSet.movies}${foreach movieSet.movies movie , }url('../images/${movie;copyArtwork(type=FANART, thumb=false, width=1280, escape=true, default=../nofanart.png)}')${end}${end};">
	<a class="back-btn" href="../moviesets.html" title="Volver al listado" data-i18n-title="backToList">
		<svg viewBox="0 0 512 512"><path d="M401.4 224h-214l83-79.4c11.9-12.5 11.9-32.7 0-45.2s-31.2-12.5-43.2 0L89 233.4c-6 5.8-9 13.7-9 22.4v.4c0 8.7 3 16.6 9 22.4l138.1 134c12 12.5 31.3 12.5 43.2 0 11.9-12.5 11.9-32.7 0-45.2l-83-79.4h214c16.9 0 30.6-14.3 30.6-32 .1-18-13.6-32-30.5-32z"/></svg>
	</a>
	<div class="hero-links">
		<a class="crosslink" href="../../index.html" data-route="home" data-root="../../" data-rest="" data-i18n="toHome">⌂ Inicio</a>
		<a class="crosslink stats" href="../../stats.html" data-route="stats" data-root="../../" data-rest="" data-i18n="toStats">Estadísticas</a>
	</div>
	<div class="lang-switcher" id="langSwitcher">
		<button type="button" data-lang="ca">CA</button>
		<button type="button" data-lang="es">ES</button>
		<button type="button" data-lang="en">EN</button>
	</div>
	<div class="hero-inner">
		<div class="hero-poster">
			<div class="poster-stack">
				${if movieSet.movies}${foreach movieSet.movies movie}<img src="../images/${movie;copyArtwork(type=POSTER, thumb=true, width=320, escape=true, default=../nopicture.png)}" alt="${movieSet.title}" onerror="this.onerror=null;this.src='../nopicture.png';"/>${end}${else}<img src="../nopicture.png" alt="${movieSet.title}"/>${end}
			</div>
		</div>
		<div class="hero-info">
			<h1>${movieSet.title}</h1>
		</div>
	</div>
</div>

<div class="detail-body">
	<div class="main" style="grid-column: 1 / -1;">
		${if movieSet.plot}
		<div class="plot">
			<h2 class="section-title" data-i18n="synopsisTitle">Sinopsis</h2>
			<p>${movieSet.plot}</p>
		</div>
		${end}

		<h2 class="section-title" data-i18n="moviesInCollectionTitle">Películas de la colección</h2>
		<div class="grid" id="moviesGrid">
			${foreach movieSet.movies movie}
			<div class="card" data-title="${movie.titleSortable}" data-name="${movie.title}" data-edition="${if movie.edition}${movie.edition}${end}" data-vid="${if movie.ids.tmdb}tmdb:${movie.ids.tmdb}${else}${if movie.ids.imdb}imdb:${movie.ids.imdb}${end}${end}" data-year="${movie.year}" data-media="${foreach movie.mediaFiles mf}${mf.type}~${mf.videoWidth}x${mf.videoHeight}~${mf.videoCodec}~${mf.hdrFormat}~${mf.filesize}~${foreach mf.audioStreams a}${a.audioChannels}:${a.language},${end}§${end}">
				<a class="poster-link" href="../../movies/movies/${movie;filename(escape=false)}.html" data-route="movies" data-root="../../" data-rest="movies/${movie;filename(escape=false)}.html">
					<img src="../images/${movie;copyArtwork(type=POSTER, thumb=true, width=350, escape=true, default=../nopicture.png)}" alt="${movie.title}" loading="lazy" onerror="this.onerror=null;this.src='../nopicture.png';"/>
				</a>
				<div class="meta">
					<a class="title" href="../../movies/movies/${movie;filename(escape=false)}.html" data-route="movies" data-root="../../" data-rest="movies/${movie;filename(escape=false)}.html">${movie.title}</a>
					<div class="sub">${movie.year}</div>
				</div>
			</div>
			${end}
		</div>
	</div>
</div>

<footer class="site-footer" data-i18n="footer">Generado con tinyMediaManager · plantilla Modern Grid</footer>
<script src="../../config.js"></script>
<script src="../app.js"></script>
</body>
</html>
